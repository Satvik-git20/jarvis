# --- JARVIS keys -------------------------------------------------------------
# Copy to `.env` and fill in. Every one of these has a no-card free tier.
# Providers with no key (listed in README) work with nothing configured.

# LLM providers. The router fails over in this order: ollama -> openrouter ->
# groq -> cerebras -> gemini. First one with a key and budget left wins.
OPENROUTER_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=

# Web search cascade: tavily -> jina_reader -> ddgs
TAVILY_API_KEY=
JINA_API_KEY=

# Image generation (Pollinations). Free with a free account key.
POLLINATIONS_KEY=

# Voice fallback when local Whisper is unavailable. Same key as GROQ_API_KEY.
# GROQ_API_KEY=

# Local Ollama. Already running on your machine.
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=qwen3:4b-instruct-2507-q4_K_M
OLLAMA_EMBED_MODEL=nomic-embed-text

# --- Daemon ------------------------------------------------------------------
# opencode's jarvis.ts plugin talks to this. Token is required: any web page
# your browser loads can reach 127.0.0.1, so an unauthenticated port 8765
# would be callable by anything you visit.
JARVIS_DAEMON_HOST=127.0.0.1
JARVIS_DAEMON_PORT=8765
JARVIS_DAEMON_TOKEN=

# --- Local paths -------------------------------------------------------------
JARVIS_DATA_DIR=C:\jarvis\.jarvis

# --- Privacy -----------------------------------------------------------------
# Set to 1 to hard-disable providers whose free tier trains on your data.
# Google's free tier does; OpenRouter/Groq/Cerebras do not.
JARVIS_EXCLUDE_PRIVACY_UNSAFE=0

# Contact string used in the HTTP User-Agent. Wikipedia's edge returns 403 to
# any client whose User-Agent has no way to reach it, so put a real email or
# URL you answer to here. Affects Wikipedia only.
JARVIS_CONTACT=
